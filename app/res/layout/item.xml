<?xml version="1.0" encoding="utf-8"?>
<!-- Картка черги у віджеті: один рядок (черга · з якого часу · стан); натиснути — графік на сьогодні й завтра. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="3dp">
    <LinearLayout android:id="@+id/card" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="@drawable/card_na"
        android:paddingLeft="12dp" android:paddingRight="8dp" android:paddingTop="4dp" android:paddingBottom="4dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/name" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#FFFFFFFF" android:textSize="15sp" android:textStyle="bold" android:singleLine="true" />
            <TextView android:id="@+id/since" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:paddingLeft="6dp" android:textColor="#FF8B9BB4" android:textSize="12sp" android:singleLine="true" android:ellipsize="end" />
            <TextView android:id="@+id/status" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="14sp" android:textStyle="bold" android:singleLine="true" />
        </LinearLayout>
        <LinearLayout android:id="@+id/more" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:visibility="gone">
            <TextView android:id="@+id/t1" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFE8EDF2"
                android:textSize="12sp" android:layout_marginTop="2dp" android:singleLine="true" android:ellipsize="end" />
            <ImageView android:id="@+id/b1" android:layout_width="match_parent" android:layout_height="18dp" android:scaleType="fitXY" android:layout_marginTop="2dp" />
            <TextView android:id="@+id/t2" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFE8EDF2"
                android:textSize="12sp" android:layout_marginTop="2dp" android:singleLine="true" android:ellipsize="end" />
            <ImageView android:id="@+id/b2" android:layout_width="match_parent" android:layout_height="18dp" android:scaleType="fitXY" android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
