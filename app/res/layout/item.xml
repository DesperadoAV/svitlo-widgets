<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="5dp">
    <LinearLayout android:id="@+id/card" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="@drawable/card_na"
        android:paddingLeft="14dp" android:paddingRight="10dp" android:paddingTop="7dp" android:paddingBottom="7dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/name" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:textColor="#FFFFFFFF" android:textSize="16sp" android:textStyle="bold" android:singleLine="true" />
            <TextView android:id="@+id/status" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="15sp" android:textStyle="bold" android:singleLine="true" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:id="@+id/since" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:textColor="#FF8B9BB4" android:textSize="13sp" android:singleLine="true" />
            <TextView android:id="@+id/hint" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="графік ▾" android:textColor="#FF6B7B8F" android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/more" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:visibility="gone" android:paddingTop="4dp">
            <TextView android:id="@+id/t1" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFE8EDF2" android:textSize="13sp" />
            <ImageView android:id="@+id/b1" android:layout_width="match_parent" android:layout_height="22dp" android:scaleType="fitXY" android:layout_marginTop="2dp" />
            <TextView android:id="@+id/t2" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFE8EDF2" android:textSize="13sp" android:layout_marginTop="4dp" />
            <ImageView android:id="@+id/b2" android:layout_width="match_parent" android:layout_height="22dp" android:scaleType="fitXY" android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
