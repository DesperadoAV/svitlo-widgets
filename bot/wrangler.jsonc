// Cloudflare: бот для мешканців «Світло В Славутичі» (svitlo-public).
// Workers Builds: Root directory = bot, Deploy command = npx wrangler deploy
{
  "name": "svitlo-public",
  "main": "worker.js",
  "compatibility_date": "2026-10-31",
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  // раз на хвилину: оновлює спільну картку в Telegram, якщо щось змінилося
  "triggers": { "crons": ["* * * * *"] },
  // та сама база, що й в основного бота svitlo51 (лише читає черги й графіки)
  "d1_databases": [
    { "binding": "DB", "database_name": "svitlo", "database_id": "e600002a-ab0a-41f9-996e-5e39f63f7fa5" }
  ],
  "observability": { "enabled": true }
}
