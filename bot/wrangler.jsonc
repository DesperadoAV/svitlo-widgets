// Cloudflare: бот для мешканців «Світло В Славутичі» (svitlo-public).
// Викладає GitHub Actions (.github/workflows/bot.yml): сам створює базу svitlo-public і підставляє її ID замість AUTO.
{
  "name": "svitlo-public",
  "main": "worker.js",
  "compatibility_date": "2026-10-31",
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  // раз на хвилину: бере стан черг в основного бота і оновлює спільну картку в Telegram, якщо щось змінилося
  "triggers": { "crons": ["* * * * *"] },
  // своя база бота (хто писав боту, ID картки, останній знімок даних). До бази основного бота доступу немає.
  "d1_databases": [
    { "binding": "DB", "database_name": "svitlo-public", "database_id": "AUTO" }
  ],
  // виклик самого себе — щоб розіслати сповіщення багатьом людям швидше (кілька помічників паралельно)
  "services": [{ "binding": "SELF", "service": "svitlo-public" }],
  // звідки брати дані (основний бот, версія 4.0.5+)
  "vars": { "MAIN_URL": "https://svitlo51.a-m-vasylets.workers.dev" },
  "observability": { "enabled": true }
}
